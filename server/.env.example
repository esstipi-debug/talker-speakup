# Copy to server/.env and fill in. The app runs with the mock brain even if no key is set.

# --- Mode ---
# Sets the brain and tts defaults together: web | cloud | hybrid.
# Unset (or `auto`) reproduces the pre-modes behaviour exactly. Every explicit
# variable below beats the mode. The npm scripts pass --mode= instead, which is
# what `npm run dev:hybrid` does.
# SPEAKUP_MODE=hybrid

# --- Brain (LLM) ---
# Auto-detect: no key -> mock, key present -> mistral. Force with BRAIN_PROVIDER.
# BRAIN_PROVIDER=mistral
# MISTRAL_API_KEY=sk-your-key-here
MISTRAL_MODEL=mistral-small-latest

# Alternatives (wired in later milestones):
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama4

# --- TTS (coach voice) ---
# kokoro   -> server synthesizes via kokoro-fastapi on :8880 (default)
# voicebox -> server synthesizes via a local voicebox instance (also Kokoro-backed, plus others)
# browser  -> server sends no audio; client speaks via SpeechSynthesis (smoke-test)
# Unset resolves to kokoro by default, same as setting it explicitly — leave it
# commented so --mode= (or SPEAKUP_MODE) is free to choose the voice instead.
# TTS_PROVIDER=kokoro
KOKORO_URL=http://localhost:8880/v1
KOKORO_VOICE=af_heart          # English voice; af_*/am_* = US, bf_*/bm_* = UK
KOKORO_MODEL=kokoro
KOKORO_FORMAT=mp3              # mp3 | wav | opus

# --- STT (server-side path, consumed by POST /turn/audio; unset -> browser Web Speech) ---
# voicebox -> server transcribes audio via a local voicebox instance (Whisper)
# (unset)  -> no server-side STT; client relies on the Web Speech API only
# STT_PROVIDER=voicebox

# --- Voicebox (shared by TTS_PROVIDER=voicebox and STT_PROVIDER=voicebox) ---
# Run via `docker compose up` from a voicebox checkout; see README for headless setup notes.
VOICEBOX_URL=http://localhost:17493
VOICEBOX_ENGINE=kokoro
VOICEBOX_VOICE=af_heart        # preset voice id; see GET /profiles/presets/{engine}
VOICEBOX_LANGUAGE=en
VOICEBOX_PROFILE_NAME=SpeakUp Coach
VOICEBOX_STT_LANGUAGE=en
# VOICEBOX_STT_MODEL=base       # base|small|medium|large|turbo (unset -> voicebox's own default)

# --- Pronunciation (local phoneme scoring, M7) ---
# local -> server scores via the MFA sidecar at PRON_SIDECAR_URL
# mock  -> deterministic phone-level stub, no sidecar required
# (unset/none) -> no pronunciation scoring; a first-class supported state, not an error
# PRONUNCIATION_PROVIDER=local
PRON_SIDECAR_URL=http://127.0.0.1:7654
PRON_TIMEOUT_MS=30000

# --- Feedback (M2) ---
# M2 runs TWO LLM calls per turn: the coach's reply and the upgrades pass.
# Without a key, Harper still gives you real grammar corrections offline and
# free — only the `upgrades` channel goes quiet.
# MISTRAL_API_KEY=

# Which coach system prompt to run. m2 (default) pushes for elaboration and
# speaks C1-level English; m1 is the frozen pre-M2 baseline, kept so the two
# can be compared on real conversation. See the M2 spec §3 D3.
# COACH_PROMPT=m2

# --- Seed (M8) ---
# Unset -> the coach opens from a built-in rotation of subjects. Set to a
# comma-separated list of RSS/Atom feed URLs (YouTube channel feeds work
# as-is) and the coach opens on topics pulled from those instead, falling
# back to the rotation whenever the cache is empty or every feed is dead.
# SOURCE_FEEDS=https://www.youtube.com/feeds/videos.xml?channel_id=UC...,https://example.com/feed.xml

# --- DB / server ---
DATABASE_URL="file:./dev.db"
PORT=3001

# --- Deployment (Railway) ---
# Set these in the Railway dashboard, not in a file — the deployed service has
# no .env and `npm start` deliberately does not pass --env-file.
#   TTS_PROVIDER=browser
#   DATABASE_URL=file:/data/speakup.db   # absolute, on the mounted Volume
# PORT is injected by the platform and already read by src/index.js.
