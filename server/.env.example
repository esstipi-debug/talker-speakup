# Copy to server/.env and fill in. The app runs with the mock brain even if no key is set.

# --- Brain (LLM) ---
# Auto-detect: no key -> mock, key present -> mistral. Force with BRAIN_PROVIDER.
# BRAIN_PROVIDER=mistral
# MISTRAL_API_KEY=sk-your-key-here
MISTRAL_MODEL=mistral-small-latest

# Alternatives (wired in later milestones):
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama4

# --- TTS (coach voice) ---
# kokoro   -> server synthesizes via kokoro-fastapi on :8880 (default)
# voicebox -> server synthesizes via a local voicebox instance (also Kokoro-backed, plus others)
# browser  -> server sends no audio; client speaks via SpeechSynthesis (smoke-test)
TTS_PROVIDER=kokoro
KOKORO_URL=http://localhost:8880/v1
KOKORO_VOICE=af_heart          # English voice; af_*/am_* = US, bf_*/bm_* = UK
KOKORO_MODEL=kokoro
KOKORO_FORMAT=mp3              # mp3 | wav | opus

# --- STT (server-side path, consumed by POST /turn/audio; unset -> browser Web Speech) ---
# voicebox -> server transcribes audio via a local voicebox instance (Whisper)
# (unset)  -> no server-side STT; client relies on the Web Speech API only
# STT_PROVIDER=voicebox

# --- Pronunciation (CAPT; consumed by POST /pron/assess) ---
# mock   -> deterministic offline pseudo-scores, $0, no Docker (default)
# local  -> score via the pronunciation sidecar container on :8899
# azure  -> a manually-selected, budget-capped supplement (design §13) — never
#           the default, never auto-selected by key presence alone. Wrapped in
#           a spend guard: once PRON_AZURE_MONTHLY_CAP_USD is met this month,
#           calls silently fall back to mock (degrade, never break).
PRON_PROVIDER=mock
PRON_URL=http://localhost:8899
PRON_TIMEOUT_MS=30000
# --- Azure spend guard (only consulted when PRON_PROVIDER=azure) ---
PRON_AZURE_MONTHLY_CAP_USD=12
PRON_AZURE_RATE_PER_HOUR_USD=0.66
PRON_BUDGET_STATE_FILE=.pron-budget.json
# Read by the SIDECAR container, not by the Node server. Listed here so the
# whole pron config lives in one place.
# PRON_MODEL=facebook/wav2vec2-lv-60-espeak-cv-ft
# AZURE_SPEECH_KEY=            # required to select PRON_PROVIDER=azure at all
# AZURE_SPEECH_REGION=westeurope
# AZURE_SPEECH_LOCALE=en-US

# --- Voicebox (shared by TTS_PROVIDER=voicebox and STT_PROVIDER=voicebox) ---
# Run via `docker compose up` from a voicebox checkout; see README for headless setup notes.
VOICEBOX_URL=http://localhost:17493
VOICEBOX_ENGINE=kokoro
VOICEBOX_VOICE=af_heart        # preset voice id; see GET /profiles/presets/{engine}
VOICEBOX_LANGUAGE=en
VOICEBOX_PROFILE_NAME=SpeakUp Coach
VOICEBOX_STT_LANGUAGE=en
# VOICEBOX_STT_MODEL=base       # base|small|medium|large|turbo (unset -> voicebox's own default)

# --- DB / server ---
DATABASE_URL="file:./dev.db"
PORT=3001
