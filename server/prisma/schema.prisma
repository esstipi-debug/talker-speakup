datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Session {
  id         String    @id @default(cuid())
  scenarioId String?
  scenario   Scenario? @relation(fields: [scenarioId], references: [id])
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  summary    String?
  // Which seed provider opened this session, and the id of the item that
  // supplied the topic (null for providers that have no item, like `local`).
  // This is the measurement hook: without it there is no way to compare a
  // sourced session against an unsourced one, which is the whole reason M8
  // was sequenced after M2.
  seedProvider String?
  topicId      String?
  turns      Turn[]
}

model Turn {
  id         String   @id @default(cuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id])
  role       String // "coach" | "user"
  text       String
  fluency    Int?
  confidence Int?
  xp         Int?
  // JSON-encoded pause profile. String rather than Json so the SQLite
  // connector's Json capability is not a migrate-time risk; the volume here is
  // a handful of counts per turn. Slice 4 decides for PronAttempt with data.
  prosody    String?
  // JSON-encoded track.getSettings() snapshot (spec §4.1) — the comparability
  // key for any prosody measurement. Same string-not-Json rationale as prosody.
  captureSettings String?
  // JSON-encoded M2 feedback payload. String rather than Json for the same
  // reason as prosody: the SQLite connector's Json capability stays out of the
  // migration path.
  feedback   String?
  createdAt  DateTime @default(now())
}

model ErrorLedger {
  id          String   @id @default(cuid())
  type        String // "grammar" | "vocab" | "register" | "pronunciation"
  pattern     String   @unique // clave para upsert
  example     String?
  explanation String?
  frequency   Int      @default(1)
  status      String   @default("active") // "active" | "improving" | "resolved"
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
}

model VocabItem {
  id           String   @id @default(cuid())
  term         String   @unique
  context      String?
  timesSeen    Int      @default(1)
  nextReviewAt DateTime @default(now()) // repetición espaciada (SM-2 simple)
  createdAt    DateTime @default(now())
}

model Scenario {
  id           String    @id @default(cuid())
  title        String
  goal         String
  domain       String?
  customPrompt String?
  active       Boolean   @default(true)
  sessions     Session[]
}

model Progress {
  id            String   @id @default(cuid())
  date          DateTime @default(now())
  sessionsCount Int      @default(0)
  avgFluency    Float?
  avgConfidence Float?
}
